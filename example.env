# Example environment variables for DCMCP
# Copy or rename this file to .env and customize values.

# Directory for logs (default: shared_data/logs)
LOG_DIR=shared_data/logs

# SQLite database file path for Titanic dataset
DB_PATH=shared_data/titanic.db

# Optional auth token. Set a strong random string to enable auth.
# Leave empty to disable authentication.
AUTH_TOKEN=YOUR_SECRET_TOKEN

